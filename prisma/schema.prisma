// ============================================================
// TAMIZHTECH ERP 2.0 — COMPLETE PRISMA SCHEMA
// Target: MongoDB Atlas Cluster0 (tamizhtech_erp)
// Robust | Auditable | Concurrency-Safe | Fully Indexed
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ─── Genuine State-Machine Enums ──────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SALES
  FINANCE
  ENGINEERING
  OPERATIONS
  VIEWER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum PaymentEntryType {
  PAYMENT
  REVERSAL
  ADJUSTMENT
  CORRECTION
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum OrderType {
  PRODUCT
  ENGINEERING
  MIXED
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  FULFILLED
  CANCELLED
}

enum FulfillmentStatus {
  NOT_REQUIRED
  PENDING
  PARTIAL
  FULFILLED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

// ─── User & Authentication ────────────────────────────────

model User {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  email             String            @unique
  emailVerified     DateTime?
  image             String?
  phone             String?
  role              UserRole          @default(VIEWER)
  status            String            @default("ACTIVE")
  passwordHash      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  sessions          Session[]
  accounts          Account[]
  employee          Employee?
  assignedLeads     Lead[]            @relation("AssignedToLead")
  assignedClients   Client[]          @relation("AssignedToClient")
  assignedTickets   SupportTicket[]   @relation("AssignedToTicket")
  assignedTasks     Task[]            @relation("AssignedToTask")
  createdTasks      Task[]            @relation("CreatedByTask")
  activityLogs      ActivityLog[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  createdExpenses   Expense[]         @relation("CreatedByExpense")
  approvedExpenses  Expense[]         @relation("ApprovedByExpense")
  comments          Comment[]
  createdProjects   Project[]         @relation("CreatedByProject")
  managedProjects   Project[]         @relation("ManagerProject")
  createdOrders     SalesOrder[]      @relation("CreatedByOrder")
  createdQuotations Quotation[]       @relation("CreatedByQuotation")
  stockLedgerEntries StockLedgerEntry[] @relation("CreatedByStockEntry")
  purchaseOrders    PurchaseOrder[]   @relation("CreatedByPO")
  recordedPayments  Payment[]         @relation("RecordedByPayment")
  createdSourcings  InventorySourcing[] @relation("CreatedBySourcing")
  createdSourcingPayments InventorySourcingPayment[] @relation("CreatedBySourcingPayment")
  createdExpensePayments  ExpensePayment[]  @relation("CreatedByExpensePayment")
  createdProductions      ProductionRecord[] @relation("CreatedByProduction")
  assignedSubmissions     InboundSubmission[] @relation("AssignedToSubmission")

  @@index([role])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ─── CRM & Customers ──────────────────────────────────────

model Client {
  id                  String          @id @default(auto()) @map("_id") @db.ObjectId
  clientCode          String          @unique
  name                String
  company             String?
  type                String          @default("INDIVIDUAL")
  status              String          @default("LEAD")
  phone               String
  mobileNormalized    String          @unique
  email               String?
  address             String?
  city                String?
  state               String?
  pincode             String?
  gstin               String?
  notes               String?
  serviceType         String?
  source              String?
  assignedToId        String?         @db.ObjectId
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  contacts            ClientContact[]
  invoices            Invoice[]
  payments            Payment[]
  followUps           FollowUp[]
  applications        Application[]
  projects            Project[]       @relation("ClientProjects")
  quotations          Quotation[]
  orders              SalesOrder[]
  submissions         InboundSubmission[] @relation("ClientSubmissions")
  assignedTo          User?           @relation("AssignedToClient", fields: [assignedToId], references: [id])

  @@index([assignedToId])
  @@index([status])
  @@index([name])
}

model ClientContact {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  clientId    String      @db.ObjectId
  name        String
  phone       String?
  email       String?
  type        String      @default("PRIMARY")
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Lead {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  leadCode         String       @unique
  name             String
  company          String?
  email            String?
  phone            String?
  status           String       @default("NEW")
  source           String?      @default("WEBSITE")
  requirement      String?
  notes            String?
  assignedToId     String?      @db.ObjectId
  externalId       String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assignedTo       User?        @relation("AssignedToLead", fields: [assignedToId], references: [id])
  followUps        FollowUp[]
  submissions      InboundSubmission[] @relation("LeadSubmissions")

  @@index([assignedToId])
  @@index([status])
  @@index([createdAt])
}

// ─── Sales: Quotations & Sales Orders ─────────────────────

model Quotation {
  id                   String          @id @default(auto()) @map("_id") @db.ObjectId
  quotationNo          String          @unique
  clientId             String          @db.ObjectId
  status               QuotationStatus @default(DRAFT)
  validUntil           DateTime
  subtotal             Int             @default(0)
  discountAmount       Int             @default(0)
  taxAmount            Int             @default(0)
  total                Int             @default(0)
  convertedToInvoiceId String?         @db.ObjectId
  notes                String?
  terms                String?
  createdById          String?         @db.ObjectId
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  client               Client          @relation(fields: [clientId], references: [id])
  createdBy            User?           @relation("CreatedByQuotation", fields: [createdById], references: [id])
  items                QuotationItem[]
  orders               SalesOrder[]

  @@index([clientId])
  @@index([status])
}

model QuotationItem {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  quotationId        String      @db.ObjectId
  productId          String?     @db.ObjectId
  itemType           String      @default("PHYSICAL_PRODUCT") // PHYSICAL_PRODUCT | SERVICE
  sku                String?
  name               String?
  description        String
  qty                Int
  unitPrice          Int
  discountPercent    Float       @default(0)
  taxRate            Float
  amount             Int
  configurationNotes String?

  quotation          Quotation   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product            Product?    @relation(fields: [productId], references: [id])

  @@index([quotationId])
  @@index([productId])
}

model SalesOrder {
  id                String            @id @default(auto()) @map("_id") @db.ObjectId
  orderNo           String            @unique
  quotationId       String?           @db.ObjectId
  clientId          String            @db.ObjectId
  orderType         OrderType         @default(PRODUCT)
  status            OrderStatus       @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(NOT_REQUIRED)
  subtotal          Float
  taxAmount         Float             @default(0)
  totalAmount       Float
  notes             String?
  createdById       String            @db.ObjectId
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  client            Client            @relation(fields: [clientId], references: [id])
  quotation         Quotation?        @relation(fields: [quotationId], references: [id])
  createdBy         User              @relation("CreatedByOrder", fields: [createdById], references: [id])
  items             SalesOrderItem[]
  invoices          Invoice[]
  projects          Project[]

  @@index([clientId])
  @@index([status])
}

model SalesOrderItem {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  orderId      String      @db.ObjectId
  productId    String?     @db.ObjectId
  description  String
  quantity     Float
  unitPrice    Float
  totalAmount  Float

  order        SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?    @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ─── Invoicing & Financial Ledger ─────────────────────────

model Invoice {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNo        String          @unique
  clientId         String          @db.ObjectId
  orderId          String?         @db.ObjectId
  clientName       String
  status           InvoiceStatus   @default(DRAFT)
  date             DateTime        @default(now())
  dueDate          DateTime
  subtotal         Int             @default(0)
  gstPercent       Float
  gstAmount        Int             @default(0)
  discountAmount   Int             @default(0)
  total            Int             @default(0)
  paidAmount       Int             @default(0)
  balance          Int             @default(0)
  issuedAt         DateTime?
  cancelledAt      DateTime?
  sentAt           DateTime?
  notes            String?
  terms            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  client           Client          @relation(fields: [clientId], references: [id])
  order            SalesOrder?     @relation(fields: [orderId], references: [id])
  items            InvoiceItem[]
  payments         Payment[]

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  invoiceId   String   @db.ObjectId
  productId   String?  @db.ObjectId
  description String
  qty                Int
  unitPrice          Int
  amount             Int
  configurationNotes String?

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  paymentNo       String            @unique
  invoiceId       String?           @db.ObjectId
  clientId        String            @db.ObjectId
  amount          Int
  date            DateTime          @default(now())
  mode            String            @default("UPI")
  status          PaymentStatus     @default(COMPLETED)
  type            PaymentEntryType  @default(PAYMENT)
  transactionId   String?
  referenceNo     String?
  notes           String?
  reversalOfId    String?           @db.ObjectId
  createdById     String?           @db.ObjectId
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  invoice         Invoice?          @relation(fields: [invoiceId], references: [id])
  client          Client            @relation(fields: [clientId], references: [id])
  createdBy       User?             @relation("RecordedByPayment", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([clientId])
  @@index([status])
  @@index([type])
  @@index([date])
}

model Expense {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  expenseNo        String           @unique
  category         String
  amount           Int
  paidAmount       Int              @default(0)
  date             DateTime         @default(now()) // Incurred date
  paidAt           DateTime?                        // Latest/full payment date
  description      String?
  status           String           @default("APPROVED") // PENDING | APPROVED | VOIDED
  paymentStatus    String           @default("UNPAID")   // UNPAID | PARTIAL | PAID
  paidTo           String?
  paymentMethod    String?          @default("BANK_TRANSFER")
  referenceNo      String?
  paymentReference String?
  notes            String?
  createdById      String?          @db.ObjectId
  approvedById     String?          @db.ObjectId
  voidedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  createdBy        User?            @relation("CreatedByExpense", fields: [createdById], references: [id])
  approvedBy       User?            @relation("ApprovedByExpense", fields: [approvedById], references: [id])
  payments         ExpensePayment[]

  @@index([category])
  @@index([date])
  @@index([paidAt])
  @@index([status])
  @@index([paymentStatus])
}

model ExpensePayment {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  expenseId        String   @db.ObjectId
  amountPaise      Int?
  amount           Int
  direction        String   @default("INCREASE") // INCREASE | DECREASE
  type             String   @default("PAYMENT") // PAYMENT | REVERSAL | ADJUSTMENT | CORRECTION
  paymentDate      DateTime @default(now())
  paymentMethod    String   @default("BANK_TRANSFER")
  paymentReference String?
  notes            String?
  createdById      String?  @db.ObjectId
  createdAt        DateTime @default(now())

  expense          Expense  @relation(fields: [expenseId], references: [id])
  createdBy        User?    @relation("CreatedByExpensePayment", fields: [createdById], references: [id])

  @@index([expenseId])
  @@index([paymentDate])
  @@index([type])
  @@index([direction])
}

model ChartOfAccount {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  code            String          @unique
  name            String
  type            String
  subType         String
  balance         Float           @default(0)
  journalEntries  JournalEntry[]
}

model JournalEntry {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  date            DateTime        @default(now())
  accountId       String          @db.ObjectId
  type            String
  amount          Float
  description     String?

  account         ChartOfAccount  @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([date])
}

// ─── Products & Stock Ledger ──────────────────────────────

model Product {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  sku                String              @unique
  name               String
  description        String?
  category           String?             @default("ROBOTICS")
  type               String              @default("PHYSICAL_PRODUCT") // RAW_MATERIAL | COMPONENT | FINISHED_PRODUCT | CONSUMABLE | SERVICE (legacy PHYSICAL_PRODUCT)
  isSaleable         Boolean             @default(false) // Default false. Only FINISHED_PRODUCT/SERVICE default to true in application logic
  quantityScale      Int                 @default(1) // 1 for countable items, fixed scale (e.g. 1000 for kg/m) for fractional
  pricingMode        String              @default("FIXED") // FIXED or REQUIREMENT_BASED
  status             String              @default("ACTIVE")
  basePrice          Float?
  taxRate            Float               @default(18)
  stockQuantityMinor Int                 @default(0) // Authoritative minor stock quantity
  stockQuantity      Int                 @default(0) // Normalized real integer quantity
  minStock           Int                 @default(5)
  normalizedName     String?
  sourceType         String?             @default("MANUAL") // WEBSITE or MANUAL
  sourceUrl          String?
  sourceSlug         String?
  sourceProductName  String?
  configurationNotes String?             // General guidance (e.g. "Spec based on requirement"), no fake defaults
  lastSyncedAt       DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  stockLedgerEntries StockLedgerEntry[]
  orderItems         SalesOrderItem[]
  poItems            PurchaseOrderItem[]
  invoiceItems       InvoiceItem[]
  quotationItems     QuotationItem[]
  sourcings          InventorySourcing[]
  producedRecords    ProductionRecord[]  @relation("ProducedInRecords")
  consumedInItems    ProductionItem[]    @relation("ConsumedInProduction")

  @@index([status])
  @@index([category])
  @@index([type])
  @@index([isSaleable])
  @@index([normalizedName])
  @@index([sourceSlug])
}

model InventorySourcing {
  id              String                     @id @default(auto()) @map("_id") @db.ObjectId
  sourcingNo      String                     @unique
  productId       String                     @db.ObjectId
  quantityMinor   Int?                       // Authoritative minor quantity
  quantity        Int
  sourceType      String                     // ONLINE, OFFLINE, IN_HOUSE
  vendorName      String?
  unitCostPaise   Int?                       // Authoritative integer unit cost in paise
  unitCost        Int
  totalCostPaise  Int?                       // Authoritative integer total cost in paise
  totalCost       Int
  purchaseDate    DateTime                   @default(now())
  status          String                     @default("ACTIVE") // ACTIVE | VOIDED
  voidedAt        DateTime?
  voidReason      String?
  voidedById      String?                    @db.ObjectId
  paymentStatus   String                     @default("UNPAID") // UNPAID, PARTIAL, PAID
  paidAmountPaise Int?                       @default(0)
  paidAmount      Int                        @default(0)
  paidAt          DateTime?
  paymentMethod   String?                    // UPI, BANK_TRANSFER, CASH, CREDIT_CARD, etc.
  referenceNo     String?
  notes           String?
  createdById     String?                    @db.ObjectId
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  product         Product                    @relation(fields: [productId], references: [id])
  createdBy       User?                      @relation("CreatedBySourcing", fields: [createdById], references: [id])
  payments        InventorySourcingPayment[]

  @@index([productId])
  @@index([sourceType])
  @@index([status])
  @@index([purchaseDate])
  @@index([paidAt])
  @@index([createdAt])
}

model InventorySourcingPayment {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  sourcingId       String            @db.ObjectId
  amountPaise      Int?              // Positive integer paise
  amount           Int
  direction        String            @default("INCREASE") // INCREASE | DECREASE
  type             String            @default("PAYMENT") // PAYMENT | REVERSAL | ADJUSTMENT | CORRECTION
  paymentDate      DateTime          @default(now())
  paymentMethod    String            @default("BANK_TRANSFER")
  paymentReference String?
  notes            String?
  createdById      String?           @db.ObjectId
  createdAt        DateTime          @default(now())

  sourcing         InventorySourcing @relation(fields: [sourcingId], references: [id])
  createdBy        User?             @relation("CreatedBySourcingPayment", fields: [createdById], references: [id])

  @@index([sourcingId])
  @@index([paymentDate])
  @@index([type])
  @@index([direction])
}

model StockLedgerEntry {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  productId            String    @db.ObjectId
  quantitySignedMinor  Int?      // Authoritative minor quantity signed (+/-)
  quantitySigned       Int       // Positive (+) inbound, Negative (-) outbound
  unitCostPaise        Int?      // Effective cost/WAC in paise at movement time
  unitCost             Int?      // Legacy alias
  costAmountPaise      Int?      // abs(quantitySigned) * unitCost snapshot in paise
  costAmount           Int?      // Legacy alias
  effectiveAt          DateTime? @default(now()) // Authoritative chronological inventory timestamp
  location             String?   @default("MAIN_WAREHOUSE")
  type                 String    // OPENING, PURCHASE, PRODUCTION, PRODUCTION_CONSUMPTION, SALE, CUSTOMER_RETURN, SUPPLIER_RETURN, PRODUCTION_REVERSAL, PRODUCTION_CONSUMPTION_REVERSAL, PURCHASE_REVERSAL, RESERVATION, RELEASE, ADJUSTMENT, DAMAGE
  referenceType        String?   // INVOICE, PURCHASE_ORDER, MANUAL_ADJUSTMENT, OPENING_BALANCE, INVENTORY_SOURCING, PRODUCTION, PRODUCTION_CANCELLATION, INVENTORY_SOURCING_VOID
  referenceId          String?
  notes                String?
  createdById          String?   @db.ObjectId
  createdAt            DateTime  @default(now())

  product              Product   @relation(fields: [productId], references: [id])
  createdBy            User?     @relation("CreatedByStockEntry", fields: [createdById], references: [id])

  @@index([productId])
  @@index([productId, effectiveAt])
  @@index([type])
  @@index([effectiveAt])
  @@index([createdAt])
}

model ProductionRecord {
  id                       String             @id @default(auto()) @map("_id") @db.ObjectId
  productionNo             String             @unique
  idempotencyKey           String?
  finishedProductId        String             @db.ObjectId
  quantityProducedMinor    Int?               // Authoritative minor quantity produced
  quantityProduced         Int
  materialCostPaise        Int                // in paise (sum of component WACs * qty)
  materialCost             Int                // legacy alias
  directCostPaise          Int                @default(0) // in paise (direct labor/machining)
  directCost               Int                @default(0) // legacy alias
  totalProductionCostPaise Int                // in paise (materialCost + directCost)
  totalProductionCost      Int                // legacy alias
  unitProductionCostPaise  Int                // in paise (totalProductionCost / quantityProduced)
  unitProductionCost       Int                // legacy alias
  productionDate           DateTime           @default(now())
  status                   String             @default("COMPLETED") // COMPLETED | CANCELLED
  notes                    String?
  cancelledAt              DateTime?
  cancelReason             String?
  cancelledById            String?            @db.ObjectId
  createdById              String?            @db.ObjectId
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  finishedProduct          Product            @relation("ProducedInRecords", fields: [finishedProductId], references: [id])
  createdBy                User?              @relation("CreatedByProduction", fields: [createdById], references: [id])
  items                    ProductionItem[]

  @@index([finishedProductId])
  @@index([idempotencyKey])
  @@index([productionDate])
  @@index([status])
  @@index([createdAt])
}

model ProductionItem {
  id                    String             @id @default(auto()) @map("_id") @db.ObjectId
  productionId          String             @db.ObjectId
  inputProductId        String             @db.ObjectId
  quantityConsumedMinor Int?               // Authoritative minor quantity consumed
  quantityConsumed      Int
  unitCostPaise         Int?               // in paise snapshot (component WAC)
  unitCost              Int                // legacy alias
  totalCostPaise        Int?               // in paise snapshot (quantityConsumed * unitCost)
  totalCost             Int                // legacy alias
  notes                 String?

  production            ProductionRecord   @relation(fields: [productionId], references: [id])
  inputProduct          Product            @relation("ConsumedInProduction", fields: [inputProductId], references: [id])

  @@index([productionId])
  @@index([inputProductId])
}


// ─── Purchasing & Vendors ─────────────────────────────────

model Vendor {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  vendorCode     String          @unique
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  gstin          String?
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id               String              @id @default(auto()) @map("_id") @db.ObjectId
  poNo             String              @unique
  vendorId         String              @db.ObjectId
  status           String              @default("DRAFT")
  totalAmount      Float               @default(0)
  notes            String?
  expectedDelivery DateTime?
  createdById      String              @db.ObjectId
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  vendor           Vendor              @relation(fields: [vendorId], references: [id])
  createdBy        User                @relation("CreatedByPO", fields: [createdById], references: [id])
  items            PurchaseOrderItem[]

  @@index([vendorId])
}

model PurchaseOrderItem {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  purchaseOrderId String        @db.ObjectId
  productId       String?       @db.ObjectId
  description     String
  quantity        Float
  unitCost        Float
  totalCost       Float

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product?      @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
}

// ─── Projects & Tasks ─────────────────────────────────────

model Project {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  projectCode     String?       @unique
  name            String
  clientId        String        @db.ObjectId
  orderId         String?       @db.ObjectId
  status          ProjectStatus @default(PLANNING)
  startDate       DateTime?
  endDate         DateTime?
  budget          Float         @default(0)
  createdById     String        @db.ObjectId
  managerId       String?       @db.ObjectId
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  client          Client        @relation("ClientProjects", fields: [clientId], references: [id])
  order           SalesOrder?   @relation(fields: [orderId], references: [id])
  createdBy       User          @relation("CreatedByProject", fields: [createdById], references: [id])
  manager         User?         @relation("ManagerProject", fields: [managerId], references: [id])
  tasks           Task[]

  @@index([clientId])
  @@index([status])
}

model Task {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  projectId       String        @db.ObjectId
  title           String
  description     String?
  status          TaskStatus    @default(TODO)
  priority        String        @default("MEDIUM")
  dueDate         DateTime?
  assignedToId    String?       @db.ObjectId
  createdById     String        @db.ObjectId
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project         Project       @relation(fields: [projectId], references: [id])
  assignedTo      User?         @relation("AssignedToTask", fields: [assignedToId], references: [id])
  createdBy       User          @relation("CreatedByTask", fields: [createdById], references: [id])

  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
}

// ─── Human Resources ──────────────────────────────────────

model Employee {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String         @unique
  userId          String?        @unique @db.ObjectId
  firstName       String
  lastName        String
  designation     String
  department      String
  status          String         @default("ACTIVE")

  user            User?          @relation(fields: [userId], references: [id])
  attendance      Attendance[]
  leaveRequests   LeaveRequest[]
  salary          Payroll[]
}

model Attendance {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String         @db.ObjectId
  date            DateTime
  status          String         @default("PRESENT")
  employee        Employee       @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model LeaveRequest {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String         @db.ObjectId
  type            String
  startDate       DateTime
  endDate         DateTime
  status          String         @default("PENDING")
  employee        Employee       @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model Payroll {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  employeeId      String         @db.ObjectId
  month           Int
  year            Int
  basicSalary     Float
  netSalary       Float
  status          String         @default("DRAFT")
  employee        Employee       @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

// ─── Training & Support ───────────────────────────────────

model Application {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  appNo           String        @unique
  clientId        String        @db.ObjectId
  status          String        @default("NEW")
  course          String
  createdAt       DateTime      @default(now())

  client          Client        @relation(fields: [clientId], references: [id])

  @@index([clientId])
}

model Event {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  status          String        @default("DRAFT")
  date            DateTime
}

model SupportTicket {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  ticketNo        String        @unique
  subject         String
  status          String        @default("OPEN")
  priority        String        @default("MEDIUM")
  assignedToId    String?       @db.ObjectId

  assignedTo      User?         @relation("AssignedToTicket", fields: [assignedToId], references: [id])

  @@index([assignedToId])
}

// ─── System Infrastructure & Operational Audit ────────────

model FollowUp {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  clientId        String?       @db.ObjectId
  leadId          String?       @db.ObjectId
  date            DateTime
  mode            String        @default("CALL")
  status          String        @default("PENDING")
  notes           String?
  assignedToId    String?       @db.ObjectId

  client          Client?       @relation(fields: [clientId], references: [id])
  lead            Lead?         @relation(fields: [leadId], references: [id])

  @@index([clientId])
  @@index([leadId])
  @@index([date])
  @@index([status])
}

model ActivityLog {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @db.ObjectId
  module          String
  action          String
  details         String?
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([createdAt])
}

model Notification {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @db.ObjectId
  type            String
  title           String
  message         String
  read            Boolean       @default(false)
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
}

model AuditLog {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @db.ObjectId
  action          String
  module          String
  entityId        String?
  oldData         String?
  newData         String?
  ipAddress       String?
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([module])
  @@index([entityId])
  @@index([createdAt])
}

model Comment {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @db.ObjectId
  content         String
  entityType      String?
  entityId        String?
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

model IdempotencyRecord {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  key              String
  scope            String
  requestHash      String
  entityType       String
  entityId         String?
  status           String       @default("PENDING")
  responseSnapshot String?
  createdAt        DateTime     @default(now())
  expiresAt        DateTime

  @@unique([key, scope])
  @@index([expiresAt])
}

model BusinessSequence {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String   @unique
  prefix     String
  year       Int?
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model IntegrationLog {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  provider      String
  operation     String
  status        String
  attemptCount  Int       @default(1)
  requestId     String?
  errorCode     String?
  errorMessage  String?
  payload       String?
  response      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastAttemptAt DateTime  @default(now())
  nextRetryAt   DateTime?

  @@index([provider])
  @@index([status])
  @@index([createdAt])
}

model DocumentAttachment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  entityType   String
  entityId     String
  uploadedById String   @db.ObjectId
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

model SystemSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       String
  category    String   @default("GENERAL")
  description String?
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

// ─── Website Inbound Submissions & Outbox Event State ─────

enum SubmissionType {
  RFQ
  CONTACT
  CAREER
  CLUB_REGISTRATION
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
  SKIPPED
}

enum EventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

model InboundSubmission {
  id                  String             @id @default(auto()) @map("_id") @db.ObjectId
  submissionNo        String             @unique
  type                SubmissionType
  status              String             @default("NEW")
  source              String             @default("WEBSITE")
  idempotencyKey      String             @unique
  payloadHash         String?

  // Person / Contact Fields
  name                String
  mobile              String?
  mobileNormalized    String?
  email               String?
  company             String?
  city                String?
  state               String?
  country             String?            @default("India")

  // Subject / Message
  subject             String?
  message             String?

  // Domain-specific flexible structured payload
  payload             Json?
  attachmentMetadata  Json?

  // ERP Linkages
  clientId            String?            @db.ObjectId
  client              Client?            @relation("ClientSubmissions", fields: [clientId], references: [id])
  leadId              String?            @db.ObjectId
  lead                Lead?              @relation("LeadSubmissions", fields: [leadId], references: [id])
  assignedToId        String?            @db.ObjectId
  assignedTo          User?              @relation("AssignedToSubmission", fields: [assignedToId], references: [id])

  // Fast UI Projection Counters / Statuses (SubmissionEvent is authoritative execution history)
  sheetSyncStatus     SyncStatus         @default(PENDING)
  sheetSyncedAt       DateTime?
  sheetSyncError      String?

  customerEmailStatus SyncStatus         @default(PENDING)
  customerEmailSentAt DateTime?
  customerEmailError  String?

  adminEmailStatus    SyncStatus         @default(PENDING)
  adminEmailSentAt    DateTime?
  adminEmailError     String?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  events              SubmissionEvent[]
  auditLogs           SubmissionAuditLog[]

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([mobileNormalized])
  @@index([email])
  @@index([source])
  @@index([sheetSyncStatus])
  @@index([assignedToId])
}

model SubmissionEvent {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  submissionId  String             @db.ObjectId
  eventType     String             // SHEET_SYNC | CUSTOMER_EMAIL | ADMIN_EMAIL
  status        EventStatus        @default(PENDING)
  payload       Json?
  error         String?
  retryCount    Int                @default(0)
  lastAttemptAt DateTime?
  processedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  submission    InboundSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, eventType])
  @@index([status])
  @@index([eventType])
  @@index([createdAt])
}

model SubmissionAuditLog {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  submissionId       String             @db.ObjectId
  action             String             // SUBMISSION_CREATED, STATUS_CHANGED, ASSIGNED, CONVERTED_TO_CUSTOMER, QUOTATION_CREATED, EVENT_RETRIED, etc.
  actorType          String             @default("SYSTEM") // SYSTEM | PUBLIC | ADMIN
  performedByUserId  String?            @db.ObjectId
  performedByName    String?
  details            Json?
  createdAt          DateTime           @default(now())

  submission         InboundSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([action])
  @@index([createdAt])
}

model PendingAttachment {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  storageKey     String   @unique
  idempotencyKey String
  fileName       String
  mimeType       String
  size           Int
  checksum       String?
  status         String   @default("PENDING") // PENDING | ATTACHED | EXPIRED
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([idempotencyKey])
  @@index([status])
  @@index([expiresAt])
}



